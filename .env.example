# These are also set directly in docker-compose.yml — this file is just for
# reference / if you run the auto-pixai container standalone outside compose.

# Required: how this container reaches Chrome on the android container.
ANDROID_ADB_HOST=android
ANDROID_ADB_PORT=5555

DATA_PATH=/data/
PORT=8080

# Optional: container timezone, e.g. Europe/London
# TZ=

# Used only the very first time the container starts (before data/schedule.json
# exists) — after that, change the schedule from the dashboard.
DEFAULT_CRON=0 9 * * *

# Optional first-run seed values for the Settings page (you can just set these
# in the UI instead — env vars here are only read if settings.json doesn't exist yet).
# PUSHOVER_USER_KEY=
# PUSHOVER_APP_TOKEN=
# NOTIFY_ON_SUCCESS=false
# DEBUG_SCREENSHOTS=true
